# Compiled Executables & Binaries
bin/*
!bin/.gitkeep
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Model Weights & Checkpoints
weights/*.bin
!weights/.gitkeep

# Generated Benchmark Files
assets/*.csv
assets/*.pdf
!assets/.gitkeep

# Dataset Files & Images
data/*
!data/.gitkeep


# Temporary & Cache Files
tmp/
*.tmp
*.log

# OS Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor & IDE Files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
